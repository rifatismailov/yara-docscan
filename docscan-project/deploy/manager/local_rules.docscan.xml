<!-- DocScan — правила менеджера Wazuh (копія блоку з /var/ossec/etc/rules/local_rules.xml).
     Вставити в /var/ossec/etc/rules/local_rules.xml (або окремим файлом у /var/ossec/etc/rules/),
     потім: /var/ossec/bin/wazuh-analysisd -t && systemctl restart wazuh-manager
     Події: JSON Lines з C:\ProgramData\DocScan\results\docscan-results.json (агент, <localfile> json),
     декодер — вбудований json, окремий декодер НЕ потрібен.
     ID: 101090 база (рівень 0), 101091 HIGH, 101092 MEDIUM, 101097 помилка скану, 101101–101108 вектори HIGH. -->
<group name="docscan,">

  <rule id="101090" level="0">
    <decoded_as>json</decoded_as>
    <field name="source">^docscan$</field>
    <description>DocScan: $(verdict) $(docfile.path)</description>
    <group>docscan,</group>
  </rule>

  <!-- HIGH → алерт рівня 12 -->
  <rule id="101091" level="12">
    <if_sid>101090</if_sid>
    <field name="verdict">^HIGH$</field>
    <description>DocScan HIGH — $(summary) | $(docfile.path) | SHA256 $(docfile.sha256)</description>
    <mitre><id>T1204.002</id></mitre>
    <group>docscan_high,</group>
  </rule>

  <!-- MEDIUM → алерт рівня 7 -->
  <rule id="101092" level="7">
    <if_sid>101090</if_sid>
    <field name="verdict">^MEDIUM$</field>
    <description>DocScan MEDIUM — $(summary) | $(docfile.path) | SHA256 $(docfile.sha256)</description>
    <mitre><id>T1204.002</id></mitre>
    <group>docscan_medium,docscan_medium_low,</group>
  </rule>

  <!-- watcher не зміг просканувати файл (зайнятий/пошкоджений) — тільки в індекс -->
  <rule id="101097" level="3">
    <if_sid>101090</if_sid>
    <field name="verdict">^ERROR$</field>
    <description>DocScan: помилка сканування $(docfile.path): $(errors)</description>
    <group>docscan_error,</group>
  </rule>

  <!-- Точні вектори HIGH. findings — масив рядків. -->
  <rule id="101101" level="12">
    <if_sid>101091</if_sid>
    <field name="docscan.findings" type="pcre2">REMOTE_TEMPLATE</field>
    <description>DocScan HIGH — Віддалений шаблон: $(docscan.evidence.template_url) | $(docfile.path) | лікування: $(disarm)</description>
    <mitre><id>T1221</id></mitre>
    <group>docscan_high,docscan_remote_template,</group>
  </rule>

  <rule id="101102" level="12">
    <if_sid>101091</if_sid>
    <field name="docscan.findings" type="pcre2">PROTOCOL_HANDLER</field>
    <description>DocScan HIGH — Обробник протоколу / ms-msdt: $(docscan.evidence.template_url) | $(docfile.path) | лікування: $(disarm)</description>
    <mitre><id>T1203</id></mitre>
    <group>docscan_high,docscan_protocol_handler,</group>
  </rule>

  <rule id="101103" level="12">
    <if_sid>101091</if_sid>
    <field name="docscan.findings" type="pcre2">DDE_AUTO|DDE_LINK</field>
    <description>DocScan HIGH — Команда DDE/DDEAUTO: $(docscan.evidence.dde_command) | $(docfile.path) | лікування: $(disarm)</description>
    <mitre><id>T1559.002</id></mitre>
    <group>docscan_high,docscan_dde,</group>
  </rule>

  <rule id="101104" level="12">
    <if_sid>101091</if_sid>
    <field name="docscan.findings" type="pcre2">RTF_OBJUPDATE</field>
    <description>DocScan HIGH — Автооновлення RTF OLE (objupdate) | $(summary) | $(docfile.path)</description>
    <mitre><id>T1203</id></mitre>
    <group>docscan_high,docscan_rtf,</group>
  </rule>

  <rule id="101105" level="12">
    <if_sid>101091</if_sid>
    <field name="docscan.findings" type="pcre2">LNK_LOLBIN|LNK_URL_ARGS|LNK_OBFUSCATED|LNK_REMOTE_EXEC|EMBEDDED_LNK</field>
    <description>DocScan HIGH — Шкідливий ярлик LNK: $(docscan.evidence.lnk_target) $(docscan.evidence.lnk_args) | $(docfile.path) | лікування: $(disarm)</description>
    <mitre><id>T1204.001</id><id>T1059.001</id></mitre>
    <group>docscan_high,docscan_lnk,</group>
  </rule>

  <rule id="101106" level="12">
    <if_sid>101091</if_sid>
    <field name="docscan.findings" type="pcre2">PDF_JS_AUTO|PDF_LAUNCH</field>
    <description>DocScan HIGH — Шкідливий PDF | $(summary) | $(docfile.path)</description>
    <mitre><id>T1204.002</id><id>T1203</id></mitre>
    <group>docscan_high,docscan_pdf,</group>
  </rule>

  <rule id="101107" level="12">
    <if_sid>101091</if_sid>
    <field name="docscan.findings" type="pcre2">EMBEDDED_PE</field>
    <description>DocScan HIGH — Вкладений виконуваний файл PE | $(summary) | $(docfile.path)</description>
    <mitre><id>T1204.002</id></mitre>
    <group>docscan_high,docscan_embedded_pe,</group>
  </rule>

  <rule id="101108" level="12">
    <if_sid>101091</if_sid>
    <field name="docscan.findings" type="pcre2">MACRO_SUSPICIOUS</field>
    <description>DocScan HIGH — Підозрілий VBA/YARA: $(docscan.evidence.vba_evidence) | $(docfile.path) | лікування: $(disarm)</description>
    <mitre><id>T1204.002</id><id>T1059.005</id></mitre>
    <group>docscan_high,docscan_macro,</group>
  </rule>

  <!-- ===== HIGH: інші напрямки (нащадки 101091) ===== -->
  <rule id="101300" level="12">
    <if_sid>101091</if_sid>
    <field name="docscan.findings" type="pcre2">EQUATION_EDITOR</field>
    <description>DocScan HIGH — Equation Editor (CVE-2017-11882/2018-0802): $(summary) | $(docfile.path)</description>
    <mitre><id>T1203</id></mitre>
    <group>docscan_high,docscan_equation,</group>
  </rule>

  <rule id="101301" level="12">
    <if_sid>101091</if_sid>
    <field name="docscan.findings" type="pcre2">PACKAGE_EXECUTABLE</field>
    <description>DocScan HIGH — OLE Package з виконуваним файлом/скриптом: $(summary) | $(docfile.path)</description>
    <mitre><id>T1204.002</id></mitre>
    <group>docscan_high,docscan_package,</group>
  </rule>

  <rule id="101302" level="12">
    <if_sid>101091</if_sid>
    <field name="docscan.findings" type="pcre2">ACTIVEX_BROWSER</field>
    <description>DocScan HIGH — ActiveX-браузер у документі: $(summary) | $(docfile.path)</description>
    <mitre><id>T1203</id></mitre>
    <group>docscan_high,docscan_activex,</group>
  </rule>

  <!-- exe / dll / скрипти / архіви: збіг вендорних YARA-правил -->
  <rule id="101303" level="12">
    <if_sid>101091</if_sid>
    <field name="category">^general$</field>
    <description>DocScan HIGH — шкідливий файл (exe/dll/скрипт/архів): $(summary) | $(docfile.path) | SHA256 $(docfile.sha256)</description>
    <mitre><id>T1204.002</id></mitre>
    <group>docscan_high,docscan_general,</group>
  </rule>

  <!-- ===== MEDIUM: напрямки (нащадки 101092) ===== -->
  <rule id="101310" level="12">
    <if_sid>101092</if_sid>
    <field name="docscan.findings" type="pcre2">EXTERNAL_OLE|EXTERNAL_FRAME</field>
    <description>DocScan MEDIUM (тривога) — документ підтягує зовнішній вміст (OLE/фрейм): $(summary) | $(docfile.path)</description>
    <mitre><id>T1221</id></mitre>
    <group>docscan_medium,docscan_medium_alert,docscan_external,</group>
  </rule>

  <rule id="101311" level="7">
    <if_sid>101092</if_sid>
    <field name="docscan.findings" type="pcre2">MACRO_AUTOEXEC|MACRO_NETWORK|MACRO_PRESENT</field>
    <description>DocScan MEDIUM — макроси VBA: $(summary) | $(docfile.path)</description>
    <mitre><id>T1059.005</id></mitre>
    <group>docscan_medium,docscan_medium_low,docscan_macro,</group>
  </rule>

  <rule id="101312" level="7">
    <if_sid>101092</if_sid>
    <field name="docscan.findings" type="pcre2">PDF_JS|PDF_EMBEDDED</field>
    <description>DocScan MEDIUM — PDF з JavaScript / вкладеним файлом: $(summary) | $(docfile.path)</description>
    <mitre><id>T1204.002</id></mitre>
    <group>docscan_medium,docscan_medium_low,docscan_pdf,</group>
  </rule>

  <rule id="101313" level="7">
    <if_sid>101092</if_sid>
    <field name="docscan.findings" type="pcre2">LNK_REMOTE_TARGET|LNK_LOLBIN</field>
    <description>DocScan MEDIUM — ярлик на мережеву теку / системну утиліту: $(summary) | $(docfile.path)</description>
    <mitre><id>T1204.001</id></mitre>
    <group>docscan_medium,docscan_medium_low,docscan_lnk,</group>
  </rule>

  <rule id="101314" level="12">
    <if_sid>101092</if_sid>
    <field name="docscan.findings" type="pcre2">ACTIVEX</field>
    <description>DocScan MEDIUM (тривога) — ActiveX-елемент у документі: $(summary) | $(docfile.path)</description>
    <mitre><id>T1203</id></mitre>
    <group>docscan_medium,docscan_medium_alert,docscan_activex,</group>
  </rule>

  <rule id="101315" level="12">
    <if_sid>101092</if_sid>
    <field name="docscan.findings" type="pcre2">ALTCHUNK</field>
    <description>DocScan MEDIUM (тривога) — altChunk: docx імпортує інший документ (CVE-2023-36884): $(summary) | $(docfile.path)</description>
    <mitre><id>T1221</id></mitre>
    <group>docscan_medium,docscan_medium_alert,docscan_altchunk,</group>
  </rule>

  <rule id="101316" level="12">
    <if_sid>101092</if_sid>
    <field name="docscan.findings" type="pcre2">XLM_MACROSHEET</field>
    <description>DocScan MEDIUM (тривога) — макроаркуш Excel 4.0 (XLM): $(summary) | $(docfile.path)</description>
    <mitre><id>T1059</id></mitre>
    <group>docscan_medium,docscan_medium_alert,docscan_xlm,</group>
  </rule>

  <!-- документ без знахідок політики, але зі збігом вендорної YARA-сигнатури (файл або 2-й прохід) -->
  <rule id="101317" level="12">
    <if_sid>101092</if_sid>
    <field name="yara_file_matches" type="pcre2">\w</field>
    <description>DocScan MEDIUM (тривога) — YARA-сигнатура в документі: $(summary) | $(docfile.path)</description>
    <mitre><id>T1204.002</id></mitre>
    <group>docscan_medium,docscan_medium_alert,docscan_yara,</group>
  </rule>

  <!-- кореляція: кілька MEDIUM низького рівня (макроси / PDF / ярлики / загальний MEDIUM) на одній машині
       за короткий час — вже не випадковий робочий документ: піднімаємо до 12 (потрапляє в Telegram) -->
  <rule id="101318" level="12" frequency="3" timeframe="600">
    <if_matched_group>docscan_medium_low</if_matched_group>
    <same_field>host</same_field>
    <description>DocScan — серія підозрілих документів на $(host): 3+ MEDIUM за 10 хв (останній: $(summary) | $(docfile.path))</description>
    <mitre><id>T1204.002</id></mitre>
    <group>docscan_high,docscan_correlation,</group>
  </rule>

  <!-- лікування виконано після того, як файл звільнили (вотчер повторював, поки документ був відкритий):
       це підтвердження, а не нова загроза — не дублюємо HIGH-тривогу -->
  <rule id="101098" level="3">
    <if_sid>101091, 101101, 101102, 101103, 101104, 101105, 101106, 101107, 101108, 101300, 101301, 101302, 101303, 101092, 101310, 101311, 101312, 101313, 101314, 101315, 101316, 101317</if_sid>
    <field name="event">^DisarmRetry$</field>
    <description>DocScan: лікування виконано після закриття файлу — $(disarm) | $(docfile.path)</description>
    <group>docscan_disarm_retry,</group>
  </rule>

  <!-- файл увесь час відкритий: за 24 год вилікувати не вдалося — потрібна ручна перевірка -->
  <rule id="101099" level="12">
    <if_sid>101091, 101101, 101102, 101103, 101104, 101105, 101106, 101107, 101108, 101300, 101301, 101302, 101303</if_sid>
    <field name="event">^DisarmPending$</field>
    <description>DocScan HIGH — файл 24 год відкритий, не вилікувано, потрібна ручна перевірка | $(summary) | $(docfile.path)</description>
    <mitre><id>T1204.002</id></mitre>
    <group>docscan_high,docscan_disarm_pending,</group>
  </rule>

</group>
