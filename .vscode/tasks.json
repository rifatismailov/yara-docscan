{
  // DocScan: Cmd+Shift+B = "DocScan CI": commit, build + tests, push to GitHub if green - NO release.
  // ▷ (Code Runner, .vscode/settings.json) = the same + GitHub release vX.Y.Z.
  // Both end after the Mac check and the start of the Forgejo run: the stands, the report, the push and the release
  // go on in Forgejo by themselves. "... wait for Forgejo" (--watch) follows the run here until its result.
  // Terminal > Run Task... also has the local-only build/test.
  "version": "2.0.0",
  "tasks": [
    {
      // rules (detection + critical) - ONE tool: checks everything and builds DocScan-rules.zip with critical/;
      // checkouts: ~/yara-docscan-rules (detection rules) and ~/docscan-critical (critical rules + tests)
      "label": "Rules: check (all rule tests + package, nothing published)",
      "type": "shell",
      "command": "go run -C docscan-project/ci/cirun . rules-release --dir ${userHome}/yara-docscan-rules --critical ${userHome}/docscan-critical --yara ${workspaceFolder}/yara --yarac ${workspaceFolder}/yarac --config ${workspaceFolder}/docscan-project/ci/config.yaml --dry-run",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Rules: release (checks again, then the signed DocScan-rules.zip release)",
      "type": "shell",
      "command": "go run -C docscan-project/ci/cirun . rules-release --dir ${userHome}/yara-docscan-rules --critical ${userHome}/docscan-critical --yara ${workspaceFolder}/yara --yarac ${workspaceFolder}/yarac --config ${workspaceFolder}/docscan-project/ci/config.yaml",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "DocScan CI",
      "type": "shell",
      "command": "go run -C docscan-project/ci/cirun .",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      // the CI server (Proxmox / Forgejo) is off: this Mac builds and tests on the first reachable Windows candidate
      // of config.yaml (win10-2); a test run only - no push, no release
      "label": "DocScan CI local, no server (win10-2)",
      "type": "shell",
      "command": "go run -C docscan-project/ci/cirun . --local",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "DocScan CI without publishing (the server is not changed)",
      "type": "shell",
      "command": "go run -C docscan-project/ci/cirun .",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "DocScan CI + GitHub release (vX.Y.Z, last number +1)",
      "type": "shell",
      "command": "go run -C docscan-project/ci/cirun . --release",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "DocScan CI + GitHub release, minor (v1.0.x -> v1.1.0)",
      "type": "shell",
      "command": "go run -C docscan-project/ci/cirun . --release --bump minor",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "DocScan CI + GitHub release, wait for Forgejo (--watch)",
      "type": "shell",
      "command": "go run -C docscan-project/ci/cirun . --release --watch",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "DocScan CI (no fuzzing)",
      "type": "shell",
      "command": "go run -C docscan-project/ci/cirun . --fuzz 0",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "DocScan local: build + tests on this Mac (no push)",
      "type": "shell",
      "command": "FUZZ_SECONDS=120 sh docscan-project/ci/build-test-unix.sh",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    }
  ]
}
