{
  // DocScan: Cmd+Shift+B / ▷ = "DocScan CI": commit, push, build + tests, package published to the deployment server.
  // Terminal > Run Task... also has the local-only build/test.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DocScan CI",
      "type": "shell",
      "command": "go run -C docscan-project/ci/cirun .",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "DocScan CI without publishing (the server is not changed)",
      "type": "shell",
      "command": "go run -C docscan-project/ci/cirun . --no-publish",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "DocScan CI (no fuzzing)",
      "type": "shell",
      "command": "go run -C docscan-project/ci/cirun . --fuzz 0",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "DocScan local: build + tests on this Mac (no push)",
      "type": "shell",
      "command": "FUZZ_SECONDS=120 sh docscan-project/ci/build-test-unix.sh",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    }
  ]
}
